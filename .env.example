# Copy to .env only if your process manager loads dotenv files; never commit .env.
DATABASE_URL=postgresql://goodfind_app:replace-with-password@localhost:5432/goodfind
AUTH_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
# Optional: absolute or relative path to GoodFind's custom YOLO weights.
# Defaults to backend/goodfind_best.pt. The service will not fall back to pretrained weights.
# YOLO_MODEL_PATH=C:\\path\\to\\goodfind_best.pt
# Frontend build-time API origin (leave unset for local development).
# VITE_API_BASE_URL=http://127.0.0.1:8000
# Persistent local report-photo storage (absolute path recommended in production).
# ITEM_IMAGE_STORAGE_DIR=item-images
# Optional Gmail SMTP delivery. Keep this disabled until all SMTP values are set.
EMAIL_NOTIFICATIONS_ENABLED=false
# Gmail SMTP uses STARTTLS on port 587 and a Google App Password, never your Gmail password.
SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@example.com
SMTP_APP_PASSWORD=replace-with-google-app-password
# Defaults to SMTP_USERNAME when omitted; this can include a display name.
# EMAIL_FROM=GoodFind <your-gmail-address@example.com>
# Base URL used only for safe navigation links in email.
FRONTEND_BASE_URL=http://127.0.0.1:5173
# Suppress repeated message-alert emails for this recipient/conversation in one backend process.
EMAIL_MESSAGE_COOLDOWN_SECONDS=300
